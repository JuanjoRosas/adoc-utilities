# ==========================================================
# adoc-build
#
# Estructura generada:
#   ./build/
#   ./build/assets/
#   ./build/res/scripts/
#
# Contenido copiado:
#   ./assets/*        -> ./build/assets/
#   ./res/scripts/*   -> ./build/res/scripts/
#   ./exports/*       -> ./build/
#   ./*.html          -> ./build/
# ==========================================================

BUILD_DIR="./build"

echo "Limpiando build anterior..."
rm -rf "$BUILD_DIR"

echo "Creando estructura de directorios..."
mkdir -p "$BUILD_DIR"
mkdir -p "$BUILD_DIR/assets"
mkdir -p "$BUILD_DIR/res/scripts"

# ----------------------------------------------------------
# 1) Copiar assets
# ----------------------------------------------------------
if [ -d "./assets" ]; then
    echo "Copiando ./assets -> ./build/assets"
    cp -R ./assets/. "$BUILD_DIR/assets/"
else
    echo "Aviso: no existe ./assets"
fi

# ----------------------------------------------------------
# 2) Copiar scripts
# ----------------------------------------------------------
if [ -d "./res/scripts" ]; then
    echo "Copiando ./res/scripts -> ./build/res/scripts"
    cp -R ./res/scripts/. "$BUILD_DIR/res/scripts/"
else
    echo "Aviso: no existe ./res/scripts"
fi

# ----------------------------------------------------------
# 3) Copiar archivos PDF de ./exports
# ----------------------------------------------------------
if [ -d "./exports" ]; then
    echo "Copiando ./exports/*.pdf -> ./build"
    shopt -s nullglob
    pdf_files=(./exports/*.pdf)

    if [ ${#pdf_files[@]} -gt 0 ]; then
        cp "${pdf_files[@]}" "$BUILD_DIR/"
    else
        echo "Aviso: no se encontraron archivos .pdf en ./exports"
    fi
    shopt -u nullglob
else
    echo "Aviso: no existe ./exports"
fi

# ----------------------------------------------------------
# 4) Copiar archivos HTML de la raíz
# ----------------------------------------------------------
echo "Copiando archivos HTML de la raíz..."

shopt -s nullglob
html_files=(./*.html)

if [ ${#html_files[@]} -gt 0 ]; then
    cp "${html_files[@]}" "$BUILD_DIR/"
else
    echo "Aviso: no se encontraron archivos .html en la raíz"
fi
shopt -u nullglob

echo "Build completado exitosamente."